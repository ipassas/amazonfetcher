# Copy to .env and fill in values, or export them in your shell.

# Which data backend to use: rapidapi (default) or rainforest
PROVIDER=rapidapi

# RapidAPI "Real-Time Amazon Data" key (has a free Basic plan).
# Can also be set/changed later from the in-app Settings page.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
RAPIDAPI_KEY=your_rapidapi_key_here

# Dashboard passcode. If set, the web UI requires this code to log in.
# Leave unset for an open dashboard. Can also be changed in Settings.
ACCESS_CODE=

# Secret used to sign login sessions. Set a long random string in production
# (on Render this is auto-generated). A random one is used if left blank.
SECRET_KEY=

# Where to store search history + UI settings (SQLite).
HISTORY_DB=data/history.db

# Optional: Rainforest API key (only if PROVIDER=rainforest).
# RAINFOREST_API_KEY=your_rainforest_api_key_here
